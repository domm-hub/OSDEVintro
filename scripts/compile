#!/usr/bin/env xonsh

# 1. Setup Directories
mkdir -p bin/O
rm -rf bin/O/*

# 2. Assemble the Low-Level Vibes
nasm -f bin   ASM/Sector1/bootloader.asm        -o bin/O/bootloader.bin
nasm -f elf64 ASM/Sector2+/ExtendedProgram.asm  -o bin/O/ExtendedProgram.o
nasm -f elf64 ASM/SecImport/Binaries.asm        -o bin/O/Binaries.o

# 3. Compiler Configuration
args = [
    "-ffreestanding", 
    "-mno-red-zone", 
    "-m64", 
    "-fno-exceptions", 
    "-fno-rtti", 
    "-c", 
    "-O0", 
    "-msse", 
    "-I", "C++/headers", 
    "-Ttext", "0x8000"
]

# Mapping of Source -> Object
cpp_files = {
    "C++/Kernel.cpp": "Kernel.o",
    "C++/libs/drivers/IO.cpp": "IO.o",
    "C++/libs/drivers/Keyboard.cpp": "Keyboard.o",
    "C++/libs/drivers/TextPrint.cpp": "TextPrint.o",
    "C++/libs/Memory/Heap.cpp": "Heap.o",
    "C++/libs/IDT.cpp": "IDT.o",
    "C++/libs/Memory/MemoryMap.cpp": "MemoryMap.o",
    "C++/libs/Memory/Memory.cpp": "Memory.o"
}

# 4. Compile C++ Files (The Python Way)
print("Compiling C++ sources...")
for src, obj in cpp_files.items():
    x86_64-elf-g++ @(args) @(src) -o f"bin/O/{obj}"

# 5. Linking
print("Linking kernel...")
x86_64-elf-ld -T link.ld

# 6. Building the Bootable Floppy Image
print("Creating bootable image...")
dd if=/dev/zero of=bootable/bootloader.flp bs=512 count=2880 status=none
dd if=bin/O/bootloader.bin of=bootable/bootloader.flp bs=512 count=1 conv=notrunc status=none
dd if=bin/kernel.bin of=bootable/bootloader.flp bs=512 seek=1 conv=notrunc status=none

print("Booting...")